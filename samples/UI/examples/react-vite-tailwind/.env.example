# ── Server connection──────────────────────────────────────────
# See docs/connecting-to-server.md for how to get these for your deployment path
# (Agentri hosted, Community Edition, or your own Xians Server).
VITE_XIANS_SERVER_URL=https://your-server.example.com

# Defualt Tenant (Optional) 
# The tenant is switchable at runtime from the app's Tenant tab, so
# this only seeds the input box's initial value as a convenience.
VITE_XIANS_TENANT_ID=default

# OIDC login
# Works with any standard OIDC provider your server's admin-console OIDC
# config trusts, e.g. Auth0, Microsoft Entra ID, Azure AD B2C, Keycloak, or
# your own. See docs/authentication.md for how that config gets set up.
VITE_OIDC_AUTHORITY=https://your-idp.example.com
VITE_OIDC_CLIENT_ID=your-client-id
VITE_OIDC_SCOPE=openid profile email
